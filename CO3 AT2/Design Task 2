%% Virtualized RAN Framework - Short Simulation
clear; close all; clc;

% Functional Split Options
split_names = {'Option 2 (High)', 'Option 6 (Medium)', 'Option 8 (Low)'};
num_splits = 3;

% Performance parameters
vnf_delay = [0.005, 0.010, 0.015, 0.020];  % VNF processing times (s)
fronthaul_latency = 0.0001;                  % 0.1 ms

% Calculate performance for each split
latency = zeros(num_splits, 1);
fronthaul_util = zeros(num_splits, 1);

for s = 1:num_splits
    if s == 1  % High split - PDCP/RLC
        latency(s) = vnf_delay(1) + vnf_delay(2) + fronthaul_latency;
        fronthaul_util(s) = 0.10;
    elseif s == 2  % Medium split - MAC/PHY
        latency(s) = vnf_delay(1) + vnf_delay(2) + vnf_delay(3) + fronthaul_latency;
        fronthaul_util(s) = 0.30;
    else  % Low split - PHY
        latency(s) = sum(vnf_delay) + fronthaul_latency;
        fronthaul_util(s) = 0.60;
    end
end

% Network Slices
slice_names = {'eMBB', 'URLLC', 'mMTC'};
num_slices = 3;

% Slice requirements and performance
slice_latency = [0.015, 0.004, 0.080];      % Target latency (s)
slice_throughput = [100, 10, 5];             % Mbps
slice_reliability = [99.9, 99.99, 99.5];     % %

% Simulated performance (meeting requirements)
perf_latency = slice_latency + 0.002*randn(1,3);
perf_throughput = slice_throughput + 5*randn(1,3);
perf_reliability = slice_reliability + 0.05*randn(1,3);

% Results Visualization
figure('Position', [100 100 800 600]);

subplot(2,2,1);
bar(latency*1000);
set(gca, 'XTickLabel', split_names);
ylabel('Latency (ms)');
title('Functional Split Latency');
grid on;
for i = 1:num_splits
    text(i, latency(i)*1000+0.5, sprintf('%.2fms', latency(i)*1000), ...
        'HorizontalAlignment', 'center');
end

subplot(2,2,2);
bar(fronthaul_util*100);
set(gca, 'XTickLabel', split_names);
ylabel('Fronthaul Utilization (%)');
title('Fronthaul Load by Split');
grid on;
for i = 1:num_splits
    text(i, fronthaul_util(i)*100+2, sprintf('%.0f%%', fronthaul_util(i)*100), ...
        'HorizontalAlignment', 'center');
end

subplot(2,2,3);
bar(perf_latency*1000);
set(gca, 'XTickLabel', slice_names);
ylabel('Latency (ms)');
title('Network Slice Latency');
grid on;
hold on;
plot(1:3, slice_latency*1000, 'r--', 'LineWidth', 2);
legend('Actual', 'Requirement');

subplot(2,2,4);
bar_data = [perf_throughput; perf_reliability/10]';
bar(bar_data);
set(gca, 'XTickLabel', slice_names);
ylabel('Throughput (Mbps) / Reliability (%/10)');
title('Slice Throughput & Reliability');
legend('Throughput', 'Reliability/10');
grid on;

sgtitle('Virtualized RAN Framework');

% Print stats
fprintf('\n=== vRAN Results ===\n');
fprintf('\nFunctional Split:\n');
for i = 1:num_splits
    fprintf('%s: Latency=%.2fms, Fronthaul=%.0f%%\n', ...
        split_names{i}, latency(i)*1000, fronthaul_util(i)*100);
end

fprintf('\nNetwork Slices:\n');
for i = 1:num_slices
    fprintf('%s: Latency=%.2fms (req %.2fms), Throughput=%.1f Mbps, Rel=%.2f%%\n', ...
        slice_names{i}, perf_latency(i)*1000, slice_latency(i)*1000, ...
        perf_throughput(i), perf_reliability(i));
end

fprintf('\n=== Simulation Complete ===\n');
