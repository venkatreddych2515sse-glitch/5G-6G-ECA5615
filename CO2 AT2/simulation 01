clear; clc; close all;
% Parameters
Nusers = 10; N_TTI = 500; N_RB = 85; SNRdB = 20;
algos = {'RR','MaxCI','PF'};
results = struct();

for a = 1:3
    alg = algos{a};
    tp_hist = zeros(Nusers, N_TTI);
    avgRate = ones(Nusers,1);
    for tti = 1:N_TTI
        % CQI from Rayleigh fading
        h = (randn(1,Nusers)+1i*randn(1,Nusers))/sqrt(2);
        snrLin = 10^(SNRdB/10);
        cqi = min(15, max(1, round(snrLin*abs(h).^2/2))); % simplified CQI
        % Scheduler
        switch alg
            case 'RR'
                rb_alloc = mod((0:N_RB-1)+tti-1, Nusers)+1;
            case 'MaxCI'
                [~,best]=max(cqi); rb_alloc = best*ones(1,N_RB);
            case 'PF'
                pf = cqi(:) ./ (avgRate+eps);
                [~,best]=max(pf); rb_alloc = best*ones(1,N_RB);
        end
        % Throughput (kbps) = CQI * allocated RBs * 10
        rbCount = arrayfun(@(u) sum(rb_alloc==u), 1:Nusers);
        tp = cqi .* rbCount * 10;
        tp_hist(:,tti) = tp;
        avgRate = 0.8*avgRate + 0.2*tp(:);
    end
    results.(alg).tp = mean(tp_hist,2);
    results.(alg).avg = mean(mean(tp_hist));
    results.(alg).fair = sum(results.(alg).tp)^2 / (Nusers*sum(results.(alg).tp.^2));
end

% Plot
figure; 
subplot(2,1,1); bar([results.RR.avg, results.MaxCI.avg, results.PF.avg]);
set(gca,'XTickLabel',algos); ylabel('Avg TP (kbps)'); title('Throughput');
subplot(2,1,2); bar([results.RR.fair, results.MaxCI.fair, results.PF.fair]);
set(gca,'XTickLabel',algos); ylabel('Fairness'); title('Jain Fairness');
grid on; 
